# Steve creating a new Dockerfile to spin up a Flask server so we can create a dashboard to view/admin LibreChat and MongoDB
# Use an official Python runtime as a parent image
FROM python:3.9-slim

# Set the working directory in the container
WORKDIR /app

# Copy the current directory contents into the container at /app
COPY . /app

# Install any needed packages specified in requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Expose port 8082 for Flask
EXPOSE 8082

# Define environment variable for Flask app
ENV FLASK_APP=app.py

# Start the Flask app
CMD ["flask", "run", "--host=0.0.0.0", "--port=8082"]
